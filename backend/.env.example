# Copy to .env for local work. On Render, set these in the dashboard instead.
# NEVER commit the real .env file.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Database (MySQL) ---
DB_ENGINE=mysql
DB_NAME=ecommerce_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-mysql-host
DB_PORT=3306
DB_SSL_CA=/path/to/ca.pem

# --- CORS (mobile / web front-end origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
FRONTEND_URL=http://localhost:8081

# --- Razorpay (test keys while developing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shop rules ---
DELIVERY_CHARGE=40
FREE_DELIVERY_THRESHOLD=500
ESTIMATED_DELIVERY_DAYS=5

# --- Email (verification mails) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- AI shopping assistant (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
